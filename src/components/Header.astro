---
import { navJa } from "../data/ja";

const navItemsEn = [
  { label: "Profile", href: "/profile" },
  { label: "Work", href: "/work" },
  { label: "Photography", href: "/photography" },
  { label: "Hobby", href: "/hobby" },
  { label: "Thought", href: "/thought" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const ja = currentPath === "/ja" || currentPath.startsWith("/ja/");
const navItems = ja ? navJa : navItemsEn;
const homeHref = ja ? "/ja" : "/";

// Counterpart URL in the other language
const togglePath = ja
  ? currentPath.replace(/^\/ja\/?/, "/") || "/"
  : currentPath === "/"
    ? "/ja"
    : `/ja${currentPath}`;
---

<header class="fixed inset-x-0 top-3 z-50 flex justify-center px-3 sm:top-4 sm:px-4">
  <nav
    id="site-nav"
    aria-label={ja ? "メインナビゲーション" : "Main navigation"}
    class="no-scrollbar glass-nav flex max-w-full items-center gap-1 overflow-x-auto rounded-full py-1.5 pr-1.5 pl-4 whitespace-nowrap sm:gap-5 sm:py-2 sm:pr-2 sm:pl-6"
  >
    <a
      href={homeHref}
      class="text-sm font-semibold tracking-wide text-neutral-900 transition-colors hover:text-sage-600"
    >
      utahiroy
    </a>

    <ul class="flex items-center gap-0.5 sm:gap-2">
      {
        navItems.map((item) => {
          const active =
            currentPath === item.href || currentPath === item.href + "/";
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "block rounded-full px-2.5 py-2 text-sm tracking-wide transition-all sm:px-3",
                  active
                    ? "bg-white/80 font-medium text-sage-700 shadow-sm"
                    : "text-neutral-500 hover:bg-white/50 hover:text-neutral-900",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
      <li>
        <a
          href={togglePath}
          class="block rounded-full border border-white/70 bg-white/40 px-2.5 py-2 text-xs font-medium tracking-wide text-neutral-500 transition-all hover:bg-white/70 hover:text-sage-700 sm:px-3"
        >
          {ja ? "EN" : "日本語"}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // iOS-style nav: compact while scrolling down, expand on scroll up
  const nav = document.getElementById("site-nav");
  let last = 0;
  addEventListener(
    "scroll",
    () => {
      const y = scrollY;
      if (nav) {
        if (y > 96 && y > last + 2) nav.classList.add("nav-compact");
        else if (y < last - 2 || y < 96) nav.classList.remove("nav-compact");
      }
      last = y;
    },
    { passive: true },
  );
</script>

---
const navItems = [
  { label: "Profile", href: "/profile" },
  { label: "Work", href: "/work" },
  { label: "Photography", href: "/photography" },
  { label: "Hobby", href: "/hobby" },
  { label: "Thought", href: "/thought" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-neutral-50/80 backdrop-blur-lg border-b border-neutral-200/60"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a
      href="/"
      class="text-sm font-semibold tracking-wide text-neutral-900 transition-colors hover:text-sage-600"
    >
      utahiroy
    </a>

    <ul class="flex items-center gap-8">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "text-sm tracking-wide transition-colors",
                currentPath === item.href || currentPath === item.href + "/"
                  ? "text-sage-600 font-medium"
                  : "text-neutral-500 hover:text-neutral-900",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

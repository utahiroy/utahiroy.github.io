---
interface Props {
  title: string;
  description: string;
  href: string;
  cta?: string;
}

const { title, description, href, cta = "Explore" } = Astro.props;
---

<a
  href={href}
  class="group glass glass-interactive block rounded-3xl p-7"
>
  <h3
    class="text-lg font-semibold text-neutral-900 transition-colors group-hover:text-sage-700"
  >
    {title}
  </h3>
  <p class="mt-2 text-base leading-relaxed text-neutral-500">
    {description}
  </p>
  <span
    class="mt-4 inline-flex items-center text-sm font-medium text-sage-600 transition-opacity duration-300 sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100"
  >
    {cta} &rarr;
  </span>
</a>

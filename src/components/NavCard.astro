---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a
  href={href}
  class="group block rounded-2xl border border-neutral-200/80 bg-white p-6 transition-all duration-300 hover:border-sage-300 hover:shadow-lg hover:shadow-sage-100/50 hover:-translate-y-0.5"
>
  <h3
    class="text-lg font-semibold text-neutral-900 transition-colors group-hover:text-sage-700"
  >
    {title}
  </h3>
  <p class="mt-2 text-base leading-relaxed text-neutral-500">
    {description}
  </p>
  <span
    class="mt-4 inline-flex items-center text-xs font-medium text-sage-600 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
  >
    Explore &rarr;
  </span>
</a>

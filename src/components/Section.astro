---
interface Props {
  id?: string;
  class?: string;
  narrow?: boolean;
}

const { id, class: className, narrow = false } = Astro.props;
---

<section
  id={id}
  class:list={[
    "px-6 py-20 md:py-28",
    narrow ? "mx-auto max-w-2xl" : "mx-auto max-w-5xl",
    className,
  ]}
>
  <slot />
</section>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { thought, thoughts, thoughtFooter } from "../data/thought";
---

<BaseLayout
  title="Thought — Utahiro Yoshimoto"
  description="On sustainability, implementation, data, and the systems that shape real outcomes."
>
  <Section>
    <div class="reveal max-w-2xl">
      <SectionLabel label="Thought" />
      <h1
        class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl"
      >
        {thought.headline}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-neutral-500">
        {thought.summary}
      </p>
    </div>
  </Section>

  <Section narrow>
    <div class="reveal space-y-6">
      {
        thoughts.map((entry) => (
          <article class="group rounded-2xl border border-neutral-200/80 bg-white p-6 transition-all duration-300 hover:border-sage-300 hover:shadow-md hover:shadow-sage-100/30">
            <div class="flex items-center gap-3">
              <p class="text-xs font-medium text-neutral-400">{entry.date}</p>
              {entry.tags && (
                <div class="flex gap-2">
                  {entry.tags.map((tag) => (
                    <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-[10px] font-medium text-neutral-400">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
            <h3 class="mt-3 text-base font-semibold text-neutral-900 transition-colors group-hover:text-sage-700">
              {entry.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-500">
              {entry.excerpt}
            </p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section narrow>
    <div class="reveal text-center">
      <p class="text-sm text-neutral-400">
        {thoughtFooter}
      </p>
    </div>
  </Section>
</BaseLayout>

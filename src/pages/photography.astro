---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { photography, sections, photographyFooter } from "../data/photography";

const slugify = (title: string) =>
  title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<BaseLayout
  title="Photography — Utahiro Yoshimoto"
  description="Street and travel photography, all shot on a Sony α7 — Japan, the Andes, cities, and the small hours in between."
>
  <Section>
    <div class="reveal max-w-3xl">
      <SectionLabel label="Photography" />
      <h1
        class="text-5xl font-bold tracking-tight text-neutral-900 sm:text-6xl"
      >
        {photography.headline}
      </h1>
      <p class="mt-8 text-xl leading-relaxed text-neutral-500">
        {photography.summary}
      </p>
      <p class="mt-5 text-sm font-medium tracking-wide text-sage-600 uppercase">
        {photography.camera}
      </p>
      <nav class="mt-10 flex flex-wrap gap-3">
        {
          sections.map((section) => (
            <a
              href={`#${slugify(section.title)}`}
              class="rounded-full border border-neutral-200 bg-white px-5 py-2 text-sm font-medium text-neutral-600 transition-all hover:border-sage-300 hover:text-sage-700 hover:-translate-y-0.5"
            >
              {section.title}
              <span class="ml-1.5 text-neutral-300">{section.photos.length}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </Section>

  {
    sections.map((section, i) => (
      <Section id={slugify(section.title)}>
        <div class="reveal">
          <div class="mb-2 flex items-baseline gap-5">
            <span class="text-sm font-semibold tracking-widest text-sage-500">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h2 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
              {section.title}
            </h2>
          </div>
          <p class="mb-10 ml-11 max-w-2xl text-base text-neutral-400">
            {section.description}
          </p>
          <div class="columns-1 gap-5 sm:columns-2 lg:columns-3">
            {section.photos.map((photo) => (
              <figure class="mb-5 break-inside-avoid">
                <div class="group overflow-hidden rounded-2xl bg-neutral-100">
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    width={photo.width}
                    height={photo.height}
                    loading="lazy"
                    decoding="async"
                    class="h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  />
                </div>
                <figcaption class="mt-3 mb-7 flex items-baseline justify-between gap-3 px-1">
                  <span class="text-sm text-neutral-500">{photo.caption}</span>
                  <span class="text-xs font-medium text-neutral-300">
                    {photo.year}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </Section>
    ))
  }

  <Section narrow>
    <div class="reveal text-center">
      <p class="text-base text-neutral-400">
        {photographyFooter}
      </p>
    </div>
  </Section>
</BaseLayout>

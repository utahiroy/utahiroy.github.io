---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionLabel from "../components/SectionLabel.astro";
import {
  work,
  experience,
  education,
  areas,
  skills,
  certifications,
  direction,
} from "../data/work";
---

<BaseLayout
  title="Work — Utahiro Yoshimoto"
  description="ESG consulting, sustainability data, and AI automation — experience, skills, and direction."
>
  <!-- Header -->
  <Section>
    <div class="reveal max-w-2xl">
      <SectionLabel label="Work" />
      <h1
        class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl"
      >
        {work.headline}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-neutral-500">
        {work.summary}
      </p>
    </div>
  </Section>

  <!-- Experience -->
  <Section>
    <div class="reveal">
      <SectionLabel label="Experience" />
      <div class="space-y-6">
        {
          experience.map((job) => (
            <div class="rounded-2xl border border-neutral-200/80 bg-white p-6 md:p-8">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="text-base font-semibold text-neutral-900">
                  {job.role}
                </h3>
                <span class="text-xs font-medium text-neutral-400">
                  {job.period}
                </span>
              </div>
              <p class="mt-1 text-sm font-medium text-sage-700">
                {job.organization}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-neutral-600">
                {job.description}
              </p>
              <ul class="mt-4 space-y-2">
                {job.highlights.map((h) => (
                  <li class="flex items-start gap-3 text-sm text-neutral-500">
                    <span class="mt-1.5 block h-1 w-1 flex-shrink-0 rounded-full bg-sage-400" />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-5 flex flex-wrap gap-2">
                {job.tags.map((tag) => (
                  <span class="rounded-full bg-sage-50 px-3 py-1 text-xs font-medium text-sage-700">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Education -->
  <Section>
    <div class="reveal">
      <SectionLabel label="Education" />
      <div class="grid gap-6 sm:grid-cols-2">
        {
          education.map((school) => (
            <div class="rounded-2xl border border-neutral-200/80 bg-white p-6">
              <h3 class="text-sm font-semibold text-neutral-900">
                {school.school}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-600">
                {school.program}
              </p>
              {school.note && (
                <p class="mt-1 text-xs text-neutral-400">{school.note}</p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Areas of Work -->
  <Section>
    <div class="reveal">
      <SectionLabel label="Areas of Work" />
      <div class="grid gap-6 sm:grid-cols-2">
        {
          areas.map((area) => (
            <div class="rounded-2xl border border-neutral-200/80 bg-white p-6">
              <h3 class="text-sm font-semibold text-neutral-900">
                {area.name}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-500">
                {area.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Skills & Certifications -->
  <Section>
    <div class="reveal">
      <SectionLabel label="Skills" />
      <div class="flex flex-wrap gap-3">
        {
          skills.map((skill) => (
            <span class="rounded-full border border-neutral-200 px-4 py-2 text-sm text-neutral-600">
              {skill}
            </span>
          ))
        }
      </div>
      <div class="mt-10">
        <h3 class="text-sm font-semibold text-neutral-900">Certifications</h3>
        <ul class="mt-4 space-y-2">
          {
            certifications.map((cert) => (
              <li class="flex items-start gap-3 text-sm text-neutral-600">
                <span class="mt-1.5 block h-1 w-1 flex-shrink-0 rounded-full bg-sage-400" />
                <span>
                  {cert.name}
                  <span class="text-neutral-400"> — {cert.issuer}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- Current Direction -->
  <Section narrow>
    <div
      class="reveal rounded-2xl border border-sage-200/60 bg-sage-50/40 p-8"
    >
      <h2 class="text-lg font-semibold text-neutral-900">{direction.title}</h2>
      <p class="mt-4 text-base leading-relaxed text-neutral-600">
        {direction.description}
      </p>
    </div>
  </Section>
</BaseLayout>

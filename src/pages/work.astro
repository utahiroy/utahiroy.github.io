---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionLabel from "../components/SectionLabel.astro";
---

<BaseLayout title="Work — utahiroy" description="Selected projects, skills, and professional direction.">
  <Section>
    <div class="reveal max-w-2xl">
      <SectionLabel label="Work" />
      <h1 class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
        What I Build
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-neutral-500">
        A curated look at the projects, skills, and professional direction
        that define my work.
      </p>
    </div>
  </Section>

  <Section>
    <div class="reveal">
      <SectionLabel label="Selected Projects" />
      <div class="grid gap-6 sm:grid-cols-2">
        {
          [
            {
              title: "Project One",
              description:
                "A brief description of what this project is, what problem it solves, and what you learned.",
              tags: ["Design", "Development"],
            },
            {
              title: "Project Two",
              description:
                "Another project that showcases a different skill or interest area.",
              tags: ["Strategy", "Technology"],
            },
          ].map((project) => (
            <div class="rounded-2xl border border-neutral-200/80 bg-white p-6">
              <h3 class="text-base font-semibold text-neutral-900">
                {project.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-500">
                {project.description}
              </p>
              <div class="mt-4 flex gap-2">
                {project.tags.map((tag) => (
                  <span class="rounded-full bg-sage-50 px-3 py-1 text-xs font-medium text-sage-700">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section narrow>
    <div class="reveal">
      <SectionLabel label="Skills & Tools" />
      <div class="flex flex-wrap gap-3">
        {
          [
            "TypeScript",
            "React",
            "Astro",
            "Tailwind CSS",
            "Design Thinking",
            "Problem Solving",
          ].map((skill) => (
            <span class="rounded-full border border-neutral-200 px-4 py-2 text-sm text-neutral-600">
              {skill}
            </span>
          ))
        }
      </div>
    </div>
  </Section>
</BaseLayout>

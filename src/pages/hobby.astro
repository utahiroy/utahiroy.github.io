---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { hobby, hobbies } from "../data/hobby";
---

<BaseLayout
  title="Hobby — Utahiro Yoshimoto"
  description="Photography, sports, travel, music, and curiosity — the personal side."
>
  <Section>
    <div class="reveal max-w-2xl">
      <SectionLabel label="Hobby" />
      <h1
        class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl"
      >
        {hobby.headline}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-neutral-500">
        {hobby.summary}
      </p>
    </div>
  </Section>

  <Section>
    <div class="reveal grid gap-8 sm:grid-cols-2">
      {
        hobbies.map((item) => (
          <div class="group">
            <div class="aspect-[4/3] overflow-hidden rounded-2xl bg-neutral-100 transition-transform duration-300 group-hover:scale-[1.02]">
              <div class="flex h-full items-center justify-center text-sm text-neutral-300">
                Photo placeholder
              </div>
            </div>
            <h3 class="mt-4 text-base font-semibold text-neutral-900">
              {item.title}
            </h3>
            <p class="mt-1 text-sm leading-relaxed text-neutral-500">
              {item.description}
            </p>
            {item.details && (
              <p class="mt-2 text-xs leading-relaxed text-neutral-400">
                {item.details}
              </p>
            )}
          </div>
        ))
      }
    </div>
  </Section>

  <Section narrow>
    <div class="reveal text-center">
      <p class="text-sm text-neutral-400">
        This page will grow with photos and stories over time. For now, it's a
        map of what I pay attention to outside of work.
      </p>
    </div>
  </Section>
</BaseLayout>

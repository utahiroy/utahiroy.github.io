---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { hobby, hobbies } from "../data/hobby";
import { hobbyJa } from "../data/ja";

interface Props {
  ja?: boolean;
}
const { ja = false } = Astro.props;

const t = ja
  ? {
      title: "趣味 — Utahiro Yoshimoto",
      description: "写真、DJ、湖、旅、食、歴史の街歩き。仕事の外側。",
      headline: hobbyJa.headline,
      summary: hobbyJa.summary,
      items: hobbyJa.hobbies,
      footer: hobbyJa.footer,
      galleryLink: hobbyJa.galleryLink,
    }
  : {
      title: "Hobby — Utahiro Yoshimoto",
      description:
        "Photography, DJ sets, lakes, travel, food, history walks — the personal side.",
      headline: hobby.headline,
      summary: hobby.summary,
      items: hobbies,
      footer:
        "This page will grow with photos and stories over time. For now, it's a map of what I pay attention to outside of work.",
      galleryLink: "View the gallery",
    };
---

<BaseLayout title={t.title} description={t.description} lang={ja ? "ja" : "en"}>
  <Section>
    <div class="reveal max-w-2xl">
      <SectionLabel label="Hobby" />
      <h1
        class="text-5xl font-bold tracking-tight text-neutral-900 sm:text-6xl"
      >
        {t.headline}
      </h1>
      <p class="mt-8 text-xl leading-relaxed text-neutral-500">
        {t.summary}
      </p>
    </div>
  </Section>

  <Section>
    <div class="reveal grid gap-8 sm:grid-cols-2">
      {
        t.items.map((item) => (
          <div class="group">
            <div class="aspect-[4/3] overflow-hidden rounded-2xl bg-neutral-100 transition-transform duration-300 group-hover:scale-[1.02]">
              {item.image ? (
                <img
                  src={item.image.src}
                  alt={item.image.alt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div class="flex h-full items-center justify-center text-sm text-neutral-300">
                  {ja ? "写真は準備中" : "Photo placeholder"}
                </div>
              )}
            </div>
            <h3 class="mt-4 text-lg font-semibold text-neutral-900">
              {item.title}
            </h3>
            <p class="mt-2 text-base leading-relaxed text-neutral-500">
              {item.description}
            </p>
            {item.details && (
              <p class="mt-2 text-sm leading-relaxed text-neutral-400">
                {item.details}
              </p>
            )}
            {item.href && (
              <a
                href={item.href}
                class="mt-3 inline-flex items-center text-sm font-medium text-sage-600 transition-colors hover:text-sage-700"
              >
                {t.galleryLink} &rarr;
              </a>
            )}
          </div>
        ))
      }
    </div>
  </Section>

  <Section narrow>
    <div class="reveal text-center">
      <p class="text-base text-neutral-400">
        {t.footer}
      </p>
    </div>
  </Section>
</BaseLayout>

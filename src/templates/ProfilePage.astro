---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionLabel from "../components/SectionLabel.astro";
import {
  profile,
  background,
  values,
  approach,
  life,
  outlook,
  glance,
} from "../data/profile";
import { profileJa } from "../data/ja";

interface Props {
  ja?: boolean;
}
const { ja = false } = Astro.props;

const t = ja
  ? {
      title: "プロフィール — Utahiro Yoshimoto",
      description: siteDescJa(),
      headline: profileJa.headline,
      summary: profileJa.summary,
      portraitCaption: profileJa.portraitCaption,
      background: profileJa.background,
      values: profileJa.values,
      approach: profileJa.approach,
      life: profileJa.life,
      outlook: profileJa.outlook,
      glanceTitle: profileJa.glance.title,
      glance: profileJa.glance.items,
    }
  : {
      title: "Profile — Utahiro Yoshimoto",
      description:
        "Background, values, and direction — ESG consulting, AI automation, and one axis: cut CO2, early and at scale.",
      headline: profile.headline,
      summary: profile.summary,
      portraitCaption: "Marunouchi, Tokyo — same shot as my LinkedIn.",
      background,
      values,
      approach,
      life,
      outlook,
      glanceTitle: "At a Glance",
      glance,
    };

function siteDescJa() {
  return "背景、価値観、方向性。ESG コンサルティングと AI 自動化、軸は CO2 を早く大きく削ること。";
}
---

<BaseLayout title={t.title} description={t.description} lang={ja ? "ja" : "en"}>
  <!-- Header -->
  <Section>
    <div class="reveal grid items-center gap-12 md:grid-cols-5">
      <div class="md:col-span-3">
        <SectionLabel label="Profile" />
        <h1
          class="text-5xl font-bold tracking-tight text-neutral-900 sm:text-6xl"
        >
          {t.headline}
        </h1>
        <p class="mt-8 text-xl leading-relaxed text-neutral-500">
          {t.summary}
        </p>
      </div>
      <div class="relative mx-auto w-full max-w-sm md:col-span-2">
        <div
          class="absolute -inset-3 rounded-[2rem] glass-sage"
          aria-hidden="true"
        >
        </div>
        <img
          src={profile.portrait.src}
          alt={profile.portrait.alt}
          width={profile.portrait.width}
          height={profile.portrait.height}
          decoding="async"
          class="relative aspect-[4/5] w-full rounded-3xl object-cover object-center shadow-xl shadow-neutral-900/10"
        />
        <p class="relative mt-4 text-center text-sm text-neutral-400">
          {t.portraitCaption}
        </p>
      </div>
    </div>
  </Section>

  <!-- Background -->
  <Section>
    <div class="reveal max-w-2xl">
      <h2 class="text-2xl font-semibold text-neutral-900">
        {t.background.title}
      </h2>
      {
        t.background.paragraphs.map((p) => (
          <p class="mt-5 text-lg leading-relaxed text-neutral-600">{p}</p>
        ))
      }
    </div>
  </Section>

  <!-- Values -->
  <Section>
    <div class="reveal">
      <h2 class="text-2xl font-semibold text-neutral-900">{t.values.title}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {
          t.values.items.map((item) => (
            <div class="glass rounded-3xl p-7">
              <h3 class="text-base font-semibold text-neutral-900">
                {item.name}
              </h3>
              <p class="mt-2 text-base leading-relaxed text-neutral-500">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Approach -->
  <Section>
    <div class="reveal">
      <h2 class="text-2xl font-semibold text-neutral-900">
        {t.approach.title}
      </h2>
      <div class="mt-8 space-y-6">
        {
          t.approach.items.map((item) => (
            <div class="flex gap-4">
              <span class="mt-2 block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sage-400" />
              <div>
                <h3 class="text-base font-semibold text-neutral-900">
                  {item.name}
                </h3>
                <p class="mt-1 text-base leading-relaxed text-neutral-500">
                  {item.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Beyond Work -->
  <Section>
    <div class="reveal max-w-2xl">
      <h2 class="text-2xl font-semibold text-neutral-900">{t.life.title}</h2>
      {
        t.life.paragraphs.map((p) => (
          <p class="mt-5 text-lg leading-relaxed text-neutral-600">{p}</p>
        ))
      }
    </div>
  </Section>

  <!-- Where I'm Headed -->
  <Section narrow>
    <div class="reveal glass-sage rounded-[2rem] p-9">
      <h2 class="text-lg font-semibold text-neutral-900">{t.outlook.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-neutral-600">
        {t.outlook.description}
      </p>
    </div>
  </Section>

  <!-- At a Glance -->
  <Section narrow>
    <div class="reveal glass rounded-3xl p-9">
      <h2 class="text-lg font-semibold text-neutral-900">{t.glanceTitle}</h2>
      <dl class="mt-6 space-y-4">
        {
          t.glance.map((item, i) => (
            <div
              class:list={[
                "flex items-start justify-between gap-6",
                i < t.glance.length - 1 && "border-b border-neutral-100 pb-4",
              ]}
            >
              <dt class="text-base font-medium text-neutral-400">
                {item.label}
              </dt>
              <dd class="text-right text-base text-neutral-700">
                {item.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionLabel from "../components/SectionLabel.astro";
import NavCard from "../components/NavCard.astro";
import { primaryLinks } from "../data/links";
import { site } from "../data/site";
import { siteJa, homeJa } from "../data/ja";

interface Props {
  ja?: boolean;
}
const { ja = false } = Astro.props;
const t = ja ? siteJa : site;
const px = (path: string) => (ja ? `/ja${path}` : path);

const exploreEn = [
  {
    title: "Profile",
    description:
      "Tokyo, via environmental science in the U.S. — background, values, and how I work.",
    href: "/profile",
  },
  {
    title: "Work",
    description:
      "ESG consulting, sustainability data, and AI automation — experience, skills, and direction.",
    href: "/work",
  },
  {
    title: "Photography",
    description:
      "Street and travel photography on a Sony α7 — from the Atacama Desert to Shanghai.",
    href: "/photography",
  },
  {
    title: "Hobby",
    description:
      "DJ sets, lakes, travel, food, history walks — the personal side of how I see the world.",
    href: "/hobby",
  },
  {
    title: "Thought",
    description:
      "Positions I actually hold — on sustainability, AI, and how to run a life.",
    href: "/thought",
  },
];
const explore = ja ? homeJa.explore : exploreEn;

const nowItemsEn = [
  "Advising companies on supply-chain sustainability, decarbonization, ratings, and disclosure at ASUENE.",
  "Leading AI automation of ESG workflows — structuring expert work so LLMs and agents can take the repeatable parts.",
  "Shooting street and travel photography on a Sony α7, and writing down what I actually think.",
];
const nowItems = ja ? homeJa.nowItems : nowItemsEn;
---

<BaseLayout title={t.name} description={t.description} lang={ja ? "ja" : "en"}>
  <!-- Hero -->
  <section class="relative flex min-h-[85vh] items-center justify-center px-6">
    <div class="text-center">
      <h1
        class="reveal text-5xl font-bold tracking-tight text-neutral-900 sm:text-7xl md:text-8xl"
      >
        {t.name}
      </h1>
      <p
        class="reveal reveal-delay-2 mt-6 text-xl font-light text-neutral-500 sm:text-2xl"
      >
        {t.tagline}
      </p>
      <p
        class="reveal reveal-delay-3 mx-auto mt-5 max-w-xl text-base leading-relaxed text-neutral-500"
      >
        {t.intro}
      </p>
      <div class="reveal reveal-delay-5 mt-10">
        <a
          href="#explore"
          class="glass glass-interactive inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-medium text-sage-700"
        >
          <span>{ja ? "スクロールして見る" : "Scroll to explore"}</span>
          <svg
            class="h-4 w-4 animate-bounce"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Subtle decorative element -->
    <div
      class="pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden opacity-[0.03]"
    >
      <div
        class="drift h-[600px] w-[600px] rounded-full bg-sage-400 blur-[128px]"
      >
      </div>
    </div>
  </section>

  <!-- Intro -->
  <Section id="explore">
    <div class="reveal max-w-2xl">
      <SectionLabel label="About" />
      {
        ja ? (
          <p class="text-2xl font-light leading-relaxed text-neutral-700 sm:text-3xl">
            <span class="font-normal text-neutral-900">ESG コンサルティング</span>と
            <span class="font-normal text-neutral-900">データ</span>と
            <span class="font-normal text-neutral-900">AI</span>
            が交わる場所で働いています。専門家の手作業を構造化し、繰り返せる部分を AI に載せる仕事です。
          </p>
        ) : (
          <p class="text-2xl font-light leading-relaxed text-neutral-700 sm:text-3xl">
            I work where
            <span class="font-normal text-neutral-900">ESG consulting</span>,
            <span class="font-normal text-neutral-900">data</span>, and
            <span class="font-normal text-neutral-900">AI</span>
            converge — taking the expert, manual parts of sustainability work and
            putting the repeatable pieces onto AI.
          </p>
        )
      }
      <p class="mt-7 text-lg leading-relaxed text-neutral-500">
        {
          ja
            ? homeJa.aboutSub
            : "Based in Tokyo, working at ASUENE, a Japanese climate-tech company. Educated in environmental science in the U.S., headed for the forward deployed engineer's seat for sustainability."
        }
      </p>
    </div>
  </Section>

  <!-- From the α7 -->
  <Section>
    <div class="reveal">
      <SectionLabel label={ja ? homeJa.photoStripLabel : "From the α7"} />
      <a href={px("/photography")} class="group block">
        <div class="grid grid-cols-3 gap-4 md:gap-5">
          <img
            src="/photos/salt-flat-silhouette.jpg"
            alt={ja ? "ウユニ塩湖のシルエット" : "Silhouette on the Uyuni salt flat"}
            width="1067"
            height="1600"
            loading="lazy"
            decoding="async"
            class="aspect-[3/4] w-full rounded-2xl object-cover transition-transform duration-700 ease-out group-hover:scale-[1.01]"
          />
          <img
            src="/photos/mp-dawn.jpg"
            alt={ja ? "夜明けのマチュピチュ" : "Machu Picchu in first light"}
            width="1067"
            height="1600"
            loading="lazy"
            decoding="async"
            class="mt-8 aspect-[3/4] w-full rounded-2xl object-cover transition-transform duration-700 ease-out group-hover:scale-[1.01]"
          />
          <img
            src="/photos/suzhou-lantern-alley.jpg"
            alt={ja ? "夕暮れの蘇州の提灯の路地" : "Lantern alley in Suzhou at dusk"}
            width="1067"
            height="1600"
            loading="lazy"
            decoding="async"
            class="aspect-[3/4] w-full rounded-2xl object-cover transition-transform duration-700 ease-out group-hover:scale-[1.01]"
          />
        </div>
        <p
          class="mt-6 text-center text-base font-medium text-sage-600 transition-colors group-hover:text-sage-700"
        >
          {
            ja
              ? homeJa.photoStrip
              : "Photography — everything on this site is shot on one Sony α7 →"
          }
        </p>
      </a>
    </div>
  </Section>

  <!-- Navigation Cards -->
  <Section>
    <div class="reveal">
      <SectionLabel label="Explore" />
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        explore.map((card, i) => (
          <div class={`reveal reveal-delay-${i + 1}`}>
            <NavCard
              title={card.title}
              description={card.description}
              href={card.href}
              cta={ja ? "見る" : "Explore"}
            />
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Now -->
  <Section narrow>
    <div class="reveal">
      <SectionLabel label="Now" />
      <div class="glass rounded-3xl p-9">
        <h2 class="text-lg font-semibold text-neutral-900">
          {ja ? homeJa.nowTitle : "Current Focus"}
        </h2>
        <ul class="mt-4 space-y-3">
          {
            nowItems.map((item) => (
              <li class="flex items-start gap-3 text-base text-neutral-600">
                <span class="mt-1.5 block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sage-400" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- Contact -->
  <Section>
    <div class="reveal text-center">
      <SectionLabel label="Connect" />
      <p class="text-base text-neutral-500">
        {
          ja
            ? homeJa.connect
            : "Interested in connecting? Find me on these platforms."
        }
      </p>
      <div
        class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3"
      >
        {
          primaryLinks.map((link, i) => (
            <>
              {i > 0 && <span class="text-neutral-200">·</span>}
              <a
                href={link.href}
                {...(link.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                class="text-sm font-medium text-neutral-500 transition-colors hover:text-sage-600"
              >
                {link.label}
              </a>
            </>
          ))
        }
      </div>
    </div>
  </Section>
</BaseLayout>
